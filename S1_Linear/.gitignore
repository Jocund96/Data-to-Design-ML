# Local development files
.DS_Store
.venv/
venv/
env/
.env
.env.*
*.log
*.aux
*.fdb_latexmk
*.fls
*.out
*.synctex.gz
*.toc
.cache/

# Python/Jupyter cache
__pycache__/
*.py[cod]
*.egg-info/
.mypy_cache/
.ipynb_checkpoints/

# Local datasets only. Keep documentation and folder placeholders.
/data/raw/**
/data/processed/**
/data/interim/**
/data/external/**
!/data/
!/data/**/
!/data/**/.gitkeep
!/data/**/README.md

# Final submission datasets. These are included so evaluators can run S1
# notebooks and scripts immediately after cloning.
!/data/raw/**
!/data/processed/**
!/data/interim/**
!/data/external/**

# Keep result artifacts ignored by default, then include readable metrics,
# predictions, and frozen YAML configurations below.
/results/**
!/reports/
!/reports/**/
!/reports/figures/**
!/reports/tables/**
!/reports/**/.gitkeep
!/reports/**/README.md
/reports/tables/week07_baseline_predictions.csv
/reports/tables/week07_targeted_experiment_predictions.csv
!/results/
!/results/**/
!/results/**/.gitkeep
!/results/**/README.md
!/results/metrics/**
!/results/predictions/**
!/results/models/**/*.yaml

# Saved model artifacts
*.joblib
*.pkl
*.pickle
*.sav
